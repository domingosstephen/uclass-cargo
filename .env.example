# PostgreSQL connection string (from Neon, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Admin panel credentials — change these before going live!
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-secure-password-here"
ADMIN_SECRET="your-random-secret-string-here"

# Your deployed URL (set this after Vercel gives you a domain)
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
